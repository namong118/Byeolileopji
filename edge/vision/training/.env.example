# 학습 데이터·결과 위치. 이 파일을 복사해 같은 폴더에 `.env` 를 만들고 값을 채운다 (`.env` 는 커밋되지 않는다).
# 영상·이미지·라벨·가중치가 레포에 섞이지 않도록 레포 밖 폴더를 지정하는 것을 권장한다.
# 비워 두면 edge/vision/training/data, edge/vision/training/runs (둘 다 git 이 무시) 를 쓴다.

# 녹화 영상, 프레임, 라벨, 공개 데이터, 데이터셋, Label Studio DB
BYEOL_DATA_DIR=
# 사전학습 가중치, 학습 결과(best.pt), 평가 결과표
BYEOL_RUNS_DIR=
