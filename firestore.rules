rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  별일없지 — Firestore 보안 규칙  (Phase 2.5 + Phase 4.1a + Phase 4.1b)
//
//  ⚠️  DEVELOPMENT ONLY — NOT FOR PRODUCTION
//
//  아직 Firebase Auth 를 구현하지 않았다. 이 규칙은 인증 없는 PoC 앱/Worker 가
//  동작하도록 열어둔 상태다.
//  - 전체 DB 와일드카드(`match /{document=**}`) 는 쓰지 않는다.
//  - 필요한 3개 컬렉션에만 범위를 제한한다.
//
//  Phase 4.4(인증 도입) 에서 아래처럼 좁힌다:
//    allow read:  if isLinkedGuardian(resource.data.careRecipientId);
//    allow write: if false;   // 쓰기는 서버(service-account 인증)만
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // 생활 이벤트 — 앱/Worker 가 생성/조회.
    match /events/{eventId} {
      allow read: if true;   // DEVELOPMENT ONLY
      allow create: if true; // DEVELOPMENT ONLY
      allow update, delete: if false;
    }

    // 보호대상 — 조회만.
    match /careRecipients/{careRecipientId} {
      allow read: if true;   // DEVELOPMENT ONLY
      allow write: if false;
    }

    // 서버 계산 careStatus 스냅샷 (Phase 4.3 STEP B-2) — **파생 데이터**.
    //   ⚠️ DEVELOPMENT ONLY.
    //   Cloudflare Worker(무인증)가 careStatus/{careRecipientId} 문서를 상태 판정
    //   결과로 덮어쓴다. 대상자당 문서 1개(문서 id = careRecipientId), event history 아님.
    //   raw 데이터(events / devices)와 분리된 컬렉션이다.
    //   앱은 조회만 한다 (서버 계산 상태 표시는 STEP B-3 이후).
    //   실제 버전(Phase 4.4)에서는 Worker 가 service-account 인증 →
    //     allow read:  if isLinkedGuardian(resource.data.careRecipientId);
    //     allow write: if false;   // write 는 서버만
    //   로 좁힌다.
    match /careStatus/{careRecipientId} {
      allow read: if true;            // DEVELOPMENT ONLY
      allow create, update: if true;  // DEVELOPMENT ONLY — 서버(Worker) 계산 결과 write
      allow delete: if false;
    }

    // 디바이스 레지스트리.
    match /devices/{deviceId} {
      allow read: if true;   // DEVELOPMENT ONLY

      // Phase 4.1a/4.1b — Worker(무인증)가 lastEventAt / lastHeartbeatAt 만 갱신 허용.
      //   ⚠️ DEVELOPMENT ONLY.
      //   핵심 레지스트리 필드(careRecipientId / enabled / type / location / name)는
      //   클라이언트가 변경할 수 없다. 오직 이 두 상태 필드만.
      //     - lastEventAt      : /ingest-device-event 성공 시 (사람 활동 신호)
      //     - lastHeartbeatAt  : /device-heartbeat 성공 시 (기기 생존 신호)
      //   실제 버전에서는 Worker 가 service-account 인증 → 이 규칙을 제거하고 `if false`.
      allow update: if request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['lastEventAt', 'lastHeartbeatAt']);

      allow create, delete: if false;
    }
  }
}
