rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  별일없지 — Firestore 보안 규칙  (Phase 2.5 + Phase 4.1a + Phase 4.1b)
//
//  ⚠️  DEVELOPMENT ONLY — NOT FOR PRODUCTION
//
//  아직 Firebase Auth 를 구현하지 않았다. 이 규칙은 인증 없는 PoC 앱/Worker 가
//  동작하도록 열어둔 상태다.
//  - 전체 DB 와일드카드(`match /{document=**}`) 는 쓰지 않는다.
//  - 필요한 3개 컬렉션에만 범위를 제한한다.
//
//  Phase 4.4(인증 도입) 에서 아래처럼 좁힌다:
//    allow read:  if isLinkedGuardian(resource.data.careRecipientId);
//    allow write: if false;   // 쓰기는 서버(service-account 인증)만
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // 생활 이벤트 — 앱/Worker 가 생성/조회.
    match /events/{eventId} {
      allow read: if true;   // DEVELOPMENT ONLY
      allow create: if true; // DEVELOPMENT ONLY
      allow update, delete: if false;
    }

    // 보호대상 — 조회만.
    match /careRecipients/{careRecipientId} {
      allow read: if true;   // DEVELOPMENT ONLY
      allow write: if false;
    }

    // 서버 계산 careStatus 스냅샷 (Phase 4.3 STEP B-2) — **파생 데이터**.
    //   ⚠️ DEVELOPMENT ONLY.
    //   Cloudflare Worker(무인증)가 careStatus/{careRecipientId} 문서를 상태 판정
    //   결과로 덮어쓴다. 대상자당 문서 1개(문서 id = careRecipientId), event history 아님.
    //   raw 데이터(events / devices)와 분리된 컬렉션이다.
    //   앱은 조회만 한다 (서버 계산 상태 표시는 STEP B-3 이후).
    //   실제 버전(Phase 4.4)에서는 Worker 가 service-account 인증 →
    //     allow read:  if isLinkedGuardian(resource.data.careRecipientId);
    //     allow write: if false;   // write 는 서버만
    //   로 좁힌다.
    match /careStatus/{careRecipientId} {
      allow read: if true;            // DEVELOPMENT ONLY
      allow create, update: if true;  // DEVELOPMENT ONLY — 서버(Worker) 계산 결과 write
      allow delete: if false;
    }

    // 보호자 푸시 토큰 (Phase 4.4 STEP 1) — FCM 전송 대상.
    //   ⚠️ DEVELOPMENT ONLY.
    //   Firebase Auth / guardian 관계 모델 도입 전이라, 앱(무인증)이 자기 기기의
    //   FCM registration token 을 등록하고, Cloudflare Worker(무인증)가 조회한다.
    //   문서: { token, platform, careRecipientId, enabled, createdAt, updatedAt }
    //   실제 버전(Phase 4.4 Auth)에서는:
    //     allow read:   if false;   // 조회는 서버(service-account)만
    //     allow create, update: if request.auth.uid == request.resource.data.guardianUid
    //                              && isLinkedGuardian(request.resource.data.careRecipientId);
    //     allow delete: if request.auth.uid == resource.data.guardianUid;
    match /pushTokens/{tokenId} {
      allow read: if true;    // DEVELOPMENT ONLY — Worker 조회
      allow create: if true;  // DEVELOPMENT ONLY — 앱 토큰 등록

      // 갱신은 토큰/플랫폼/활성플래그/시각만. careRecipientId / createdAt 재지정 불가.
      //   - token / platform / updatedAt : 앱이 토큰 회전 시
      //   - enabled / updatedAt          : Worker 가 invalid token 비활성화 시
      allow update: if request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['token', 'platform', 'enabled', 'updatedAt']);

      allow delete: if false;
    }

    // Guardian ↔ CareRecipient 관계 (Phase 5 STEP 5.2).
    //   문서 id = `{guardianUid}_{careRecipientId}` (deterministic composite, 앱은 만들지 않는다).
    //   앱은 discovery 를 위해 `guardianUid == 로그인 uid` 로 쿼리한다 — 이 규칙은
    //   그 쿼리가 반환하는 각 문서에 대해 "자기 문서인가" 만 검증한다(Firestore 는
    //   쿼리 자체의 필터가 아니라 결과로 오는 각 문서에 이 규칙을 적용한다).
    //   문서는 Firebase Console 에서 수동 생성한다(STEP 5.2) — 앱은 생성/수정/삭제하지 않는다.
    match /guardianLinks/{linkId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.guardianUid;

      allow create, update, delete: if false;
    }

    // 디바이스 레지스트리.
    match /devices/{deviceId} {
      allow read: if true;   // DEVELOPMENT ONLY

      // Phase 4.1a/4.1b — Worker(무인증)가 lastEventAt / lastHeartbeatAt 만 갱신 허용.
      //   ⚠️ DEVELOPMENT ONLY.
      //   핵심 레지스트리 필드(careRecipientId / enabled / type / location / name)는
      //   클라이언트가 변경할 수 없다. 오직 이 두 상태 필드만.
      //     - lastEventAt      : /ingest-device-event 성공 시 (사람 활동 신호)
      //     - lastHeartbeatAt  : /device-heartbeat 성공 시 (기기 생존 신호)
      //   실제 버전에서는 Worker 가 service-account 인증 → 이 규칙을 제거하고 `if false`.
      allow update: if request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['lastEventAt', 'lastHeartbeatAt']);

      allow create, delete: if false;
    }
  }
}
