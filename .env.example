# 별일없지 — 환경변수 예시
# 이 파일을 복사해 `.env` 를 만들고 실제 값을 채운다. (`.env` 는 git 에 커밋되지 않는다)
#
#   cp .env.example .env
#
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.

# Supabase 프로젝트 URL (예: https://xxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — RLS 가 적용된 상태에서만 안전하다.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 개발용 보호대상 UUID 오버라이드.
# 비워두면 supabase/migrations 의 seed 와 동일한 고정 UUID 를 사용한다.
# EXPO_PUBLIC_CARE_RECIPIENT_ID=
# EXPO_PUBLIC_DEVICE_ID=

# ─────────────────────────────────────────────────────────────
# 절대 여기에 넣지 말 것:
#   SUPABASE_SERVICE_ROLE_KEY  ← 클라이언트 앱에 포함 금지 (RLS 우회 가능)
# ─────────────────────────────────────────────────────────────
